{
  "모델생성-매번원본재생성-게이트": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ../hooks/enforce_1origin_1gen_hook.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*generate_image.*|invoke_subagent|send_message|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../hooks/enforce_1origin_1gen_hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
